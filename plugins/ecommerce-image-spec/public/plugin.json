        {
          "type": "files",
          "fileType": "file",
          "label": "检查商品主图",
          "extensions": ["jpg", "jpeg", "png", "webp"]
        },
        {
          "type": "files",
          "fileType": "directory",
          "label": "检查文件夹中的商品图"
        }
      ]
    }
  ]
}
