{
  "name": "project-manager",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cuteyuchen/project-manager.git"
  },
  "version": "1.7.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.cjs",
    "dev": "vite",
    "prebuild": "node scripts/check-node.cjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretauri": "node scripts/check-node.cjs",
    "pretauri-dev": "node scripts/check-node.cjs",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "tauri-build": "tauri build",
    "prebuild:utools": "node scripts/check-node.cjs",
    "build:utools": "vue-tsc --noEmit && vite build --mode utools && node scripts/post-build-utools.cjs",
    "prebuild:ztools": "node scripts/check-node.cjs",
    "build:ztools": "vue-tsc --noEmit && vite build --mode ztools && node scripts/post-build-ztools.cjs",
    "publish:ztools": "node scripts/publish-ztools.cjs",
    "publish:ztools:dry": "node scripts/publish-ztools.cjs --dry-run",
    "test:ts": "node scripts/run-tests.cjs",
    "release:preflight": "node scripts/release-preflight.cjs",
    "release:prepare": "node scripts/release-prepare.cjs",
    "release:publish": "node scripts/release-publish.cjs",
    "bump": "node scripts/release-prepare.cjs",
    "bump:version": "node scripts/release-prepare.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "ansi_up": "^6.0.6",
    "diff2html": "^3.4.56",
    "element-plus": "^2.13.2",
    "marked": "^17.0.5",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.4"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@tauri-apps/cli": "2.11.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "tsx": "^4.20.3",
    "typescript": "~5.6.2",
    "unocss": "^66.6.0",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
