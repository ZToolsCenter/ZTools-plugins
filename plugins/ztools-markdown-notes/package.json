{
  "name": "ztools-markdown-notes",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.cjs",
    "benchmark": "node scripts/benchmark-workspace.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build && node scripts/finalize-build.mjs && node scripts/verify-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vditor": "^3.11.2",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vue/tsconfig": "^0.8.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  },
  "packageManager": "pnpm@10.15.0"
}
