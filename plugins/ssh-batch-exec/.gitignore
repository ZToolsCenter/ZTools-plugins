# 只排除项目根目录的 node_modules
# public/node_modules（preload 的 CommonJS 依赖）和 dist/node_modules（构建产物里的依赖）必须被跟踪
/node_modules/

# 构建缓存
.vite/
*.tsbuildinfo

# DBX 构建/开发工具依赖（backend/node_modules 为 Sidecar 运行时依赖，需随源码保留）
/dbx/node_modules/
/dbx/.dbx-dev/

# 本地 AI 文档
/.trae/

# 其他
*.log
.DS_Store
.idea/
.vscode/
