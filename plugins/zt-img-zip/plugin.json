{
  "name": "zt-img-zip",
  "title": "图片压缩",
  "description": "使用内置 Canvas 压缩图片并转换格式，支持 JPEG、PNG、WebP。",
  "version": "0.1.3",
  "main": "dist/index.html",
  "logo": "logo.png",
  "preload": "preload/services.js",
  "pluginSetting": {
    "single": true,
    "height": 560
  },
  "features": [
    {
      "code": "image-compress-convert",
      "explain": "压缩图片 / 转换为 JPEG、PNG、WebP",
      "cmds": [
        "图片压缩",
        "图片格式转换",
        {
          "type": "files",
          "label": "压缩图片",
          "fileType": "file",
          "extensions": ["jpg", "jpeg", "png", "webp", "avif"],
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "img",
          "label": "压缩图片"
        }
      ]
    }
  ]
}
