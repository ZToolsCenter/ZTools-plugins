<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import 'element-plus/theme-chalk/el-message.css'
import 'element-plus/theme-chalk/el-message-box.css'
import ReminderForm from './components/ReminderForm.vue'
import ReminderItem from './components/ReminderItem.vue'
import type { Reminder, ReminderFormData } from '../types/reminder'
import { migrateReminder } from '../types/reminder'

const props = defineProps({
  enterAction: {
    type: Object,
    required: true
  }
})

const reminders = ref<Reminder[]>([])
const showForm = ref(false)
const editingReminder = ref<Reminder | null>(null)
let timer: ReturnType<typeof setInterval> | null = null

const STORAGE_KEY = 'easyremind_reminders'

function generateId(): string {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8)
}

function loadReminders() {
  try {
    const data = window.ztools.dbStorage.getItem(STORAGE_KEY)
    if (data) {
      const raw = JSON.parse(data as string)
      reminders.value = Array.isArray(raw) ? raw.map(migrateReminder) : []
    }
  } catch {
    reminders.value = []
  }
}

function saveReminders() {
  window.ztools.dbStorage.setItem(STORAGE_KEY, JSON.stringify(reminders.value))
}

function handleSave(formData: ReminderFormData) {
  if (editingReminder.value) {
    const idx = reminders.value.findIndex(r => r.id === editingReminder.value!.id)
    if (idx > -1) {
      reminders.value[idx] = {
        ...reminders.value[idx],
        ...formData
      }
    }
  } else {
    const newReminder: Reminder = {
      id: generateId(),
      ...formData,
      enabled: true,
      lastTriggered: Date.now(),
      createdAt: Date.now()
    }
    reminders.value.push(newReminder)
  }
  saveReminders()
  showForm.value = false
  editingReminder.value = null
  ElMessage.success(editingReminder.value ? '提醒已更新' : '提醒已创建')
}

function handleEdit(reminder: Reminder) {
  editingReminder.value = reminder
  showForm.value = true
}

function handleToggle(id: string) {
  const r = reminders.value.find(r => r.id === id)
  if (r) {
    r.enabled = !r.enabled
    saveReminders()
  }
}

function handleDelete(id: string) {
  ElMessageBox.confirm('确定删除该提醒？', '提示', {
    confirmButtonText: '确定',
    cancelButtonText: '取消',
    type: 'warning'
  }).then(() => {
    reminders.value = reminders.value.filter(r => r.id !== id)
    saveReminders()
    ElMessage.success('已删除')
  }).catch(() => {})
}

function handleCancel() {
  showForm.value = false
  editingReminder.value = null
}

function handleCreate() {
  editingReminder.value = null
  showForm.value = true
}

function checkReminders() {
  const now = new Date()
  const currentDay = now.getDay()
  const currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`

  for (const reminder of reminders.value) {
    if (!reminder.enabled) continue

    let shouldTrigger = false

    if (reminder.type === 'once') {
      // 一次性定时提醒：到达触发时间即触发
      if (reminder.triggerAt && Date.now() >= reminder.triggerAt && reminder.lastTriggered === 0) {
        shouldTrigger = true
      }
    } else if (reminder.type === 'daily') {
      // 每日定点提醒：当天是选中的星期 且 时间匹配
      if ((reminder.weekdays || []).includes(currentDay) && currentTime === reminder.triggerTime) {
        const intervalMs = 60 * 1000 // 1 分钟防重复
        shouldTrigger = Date.now() - reminder.lastTriggered >= intervalMs
      }
    } else {
      // 间隔提醒：当天在时间段内 且 距上次触发超过间隔
      const todaySchedules = reminder.schedules.filter(s => s.weekday === currentDay)
      if (todaySchedules.length === 0) continue
      const inAnyRange = todaySchedules.some(s => currentTime >= s.startTime && currentTime <= s.endTime)
      if (!inAnyRange) continue
      const intervalMs = reminder.interval * 60 * 1000
      if (Date.now() - reminder.lastTriggered < intervalMs) continue
      shouldTrigger = true
    }

    if (shouldTrigger) {
      reminder.lastTriggered = Date.now()
      // once 类型触发后自动禁用
      if (reminder.type === 'once') {
        reminder.enabled = false
      }
      saveReminders()
      window.services.notify(reminder.title, reminder.content || '提醒时间到了')
    }
  }
}

onMounted(() => {
  loadReminders()
  timer = setInterval(checkReminders, 15000)
  checkReminders()
})

onUnmounted(() => {
  if (timer) clearInterval(timer)
})

const sortedReminders = computed(() => {
  return [...reminders.value].sort((a, b) => b.createdAt - a.createdAt)
})
</script>

<template>
  <div class="reminder-app">
    <div v-if="!showForm">
      <div class="app-header">
        <h2>定时提醒</h2>
        <button class="btn-add" @click="handleCreate">+ 新建</button>
      </div>

      <div v-if="sortedReminders.length === 0" class="empty-state">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <p>暂无提醒，点击"新建"创建</p>
      </div>

      <div v-else class="reminder-list">
        <ReminderItem
          v-for="r in sortedReminders"
          :key="r.id"
          :reminder="r"
          @toggle="handleToggle"
          @edit="handleEdit"
          @delete="handleDelete"
        />
      </div>
    </div>

    <ReminderForm
      v-else
      :edit-reminder="editingReminder"
      @save="handleSave"
      @cancel="handleCancel"
    />
  </div>
</template>

<style scoped>
.reminder-app {
  padding: 16px;
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.app-header h2 {
  margin: 0;
  font-size: 18px;
  color: var(--el-text-color-primary);
}

.btn-add {
  padding: 6px 16px;
  border-radius: 6px;
  border: none;
  background: var(--el-color-primary);
  color: #fff;
  cursor: pointer;
  font-size: 13px;
  transition: opacity 0.2s;
}

.btn-add:hover {
  opacity: 0.85;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 0;
  color: var(--el-text-color-secondary);
}

.empty-state p {
  margin-top: 12px;
  font-size: 14px;
}

.reminder-list {
  display: flex;
  flex-direction: column;
}
</style>
