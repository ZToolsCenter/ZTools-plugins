{
  "name": "lyriccast-ztools-plugin",
  "version": "0.4.0",
  "description": "将手机上正在播放的歌曲歌词投屏到电脑上",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev.mjs",
    "build": "npm install --prefix src-ztools/preload --omit=dev && vue-tsc && vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "typescript": "^5.3.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.0.0"
  }
}
