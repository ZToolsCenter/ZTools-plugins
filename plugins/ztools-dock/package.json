{
  "name": "ztools-dock",
  "version": "0.1.10",
  "private": true,
  "description": "程序坞 · Windows 桌面分类启动器",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/notices.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:host": "node scripts/test-host.mjs",
    "bench:host": "node scripts/benchmark-host.mjs",
    "pack": "npm run build && node scripts/package.mjs",
    "market:prepare": "node scripts/prepare-market.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "0.468.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.58.2",
    "@vitejs/plugin-vue": "5.2.1",
    "@ztools-center/plugin-cli": "1.3.2",
    "fflate": "0.8.2",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vue-tsc": "2.2.0"
  },
  "author": "jiang66-so",
  "license": "MIT"
}
