{
  "name": "json-editor",
  "version": "1.7.3",
  "description": "JSON 编辑器",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test --config=playwright.e2e.config.js",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "js-yaml": "4.3.2",
    "json-bigint": "1.0.0",
    "json-to-ts": "1.7.0",
    "monaco-editor": "0.33.0",
    "strip-json-comments": "5.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/js-yaml": "^4.0.9",
    "@types/json-bigint": "^1.0.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "typescript": "^5.3.0",
    "vite": "^6.0.11",
    "vue-tsc": "^3.3.14"
  },
  "private": true
}
