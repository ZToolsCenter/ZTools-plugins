{
  "name": "address-parser",
  "title": "收货地址智能解析",
  "description": "批量提取收货人、电话、省市区和详细地址，检查缺失字段并导出 CSV 表格。",
  "author": "harris",
  "version": "0.1.1",
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.svg",
  "categories": ["productivity", "text"],
  "pluginSetting": {
    "single": true,
    "height": 760
  },
  "features": [
    {
      "code": "address-parser",
      "explain": "收货地址智能解析",
      "icon": "logo.svg",
      "cmds": [
        "收货地址解析",
        "地址解析",
        "批量地址",
        {
          "type": "regex",
          "label": "解析选中的收货地址",
          "match": "/(?:^|\\D)((?:\\+?86[- ]?)?1[3-9](?:[- ]?\\d){9})(?!\\d)/",
          "minLength": 11,
          "maxLength": 20000
        }
      ]
    }
  ]
}
