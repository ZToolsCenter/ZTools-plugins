  "author": "hanzhe",
  "version": "1.0.0",
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5174"
  },
  "features": [
    {
      "code": "docker-pull",
      "explain": "下载 Docker 镜像为离线 tar 包",
      "icon": "logo.png",
      "cmds": [
        "docker pull"
      ]
    }
  ],
  "platform": [
    "darwin",
    "win32",
    "linux"
  ]
