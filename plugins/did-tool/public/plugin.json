{
  "$schema": "../node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "did-tool",
  "title": "Docker 镜像下载工具",
  "homepage": "https://github.com/z-hanzhe/ztools-did-tool",
