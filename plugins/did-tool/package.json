{
  "name": "did-tool",
  "version": "1.0.0",
  "description": "Docker 镜像下载工具，支持在本地无 Docker 环境下通过 HTTP 请求直接下载镜像文件，可使用代理进行加速下载，遇到网络不便的服务器可在本地下载镜像后上传至服务器进行载入",
  "author": "hanzhe",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "test": "node --test tests/*.test.cjs",
    "postinstall": "npm install --prefix public/preload --ignore-scripts"
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "typescript": "^5.3.0",
    "vite": "^6.0.11",
    "vue-tsc": "^2.0.0"
  }
}
