{
  "name": "todo",
  "version": "1.0.0",
  "description": "简单的待办清单：待处理与已完成两分类，完成的任务自动移入已完成",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test --config=playwright.e2e.config.js"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "typescript": "^5.3.0",
    "vite": "^6.0.11",
    "vue-tsc": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
