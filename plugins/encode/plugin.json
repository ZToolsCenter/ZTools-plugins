{
  "name": "encode-helper",
  "pluginName": "编码助手",
  "version": "2.0.2",
  "description": "页面式编码助手:自动识别 Base64/URL 编码/Unicode/时间戳并直接展示转换结果;UUID 生成。参考 uTools 编码小助手",
  "author": "liziqiang",
  "logo": "logo.png",
  "pluginSetting": {
    "single": true
  },
  "features": [
    {
      "code": "base64",
      "explain": "Base64 编码 / 解码(输入框粘贴 Base64 串可直接识别)",
      "cmds": [
        "base64",
        "b64",
        "base64编码",
        "base64解码",
        {
          "type": "regex",
          "match": "/^\\s*(?!\\d+\\s*$)(?=[A-Za-z0-9+/_-]*[A-Z0-9+/=_-])[A-Za-z0-9+/_-]{6,}={0,2}\\s*$/",
          "label": "Base64 解码",
          "minLength": 8
        }
      ]
    },
    {
      "code": "url",
      "explain": "URL 编码 / 解码(输入框粘贴含 %XX 的串可直接识别)",
      "cmds": [
        "url编码",
        "url解码",
        "urlencode",
        "urldecode",
        "URL",
        {
          "type": "regex",
          "match": "/^\\s*\\S*%[0-9A-Fa-f]{2}\\S*\\s*$/",
          "label": "URL 解码",
          "minLength": 3
        }
      ]
    },
    {
      "code": "unicode",
      "explain": "Unicode 转义(\\uXXXX)/ 解码(输入框粘贴 \\uXXXX 可直接识别)",
      "cmds": [
        "unicode",
        "unicode编码",
        "unicode解码",
        "\\u",
        {
          "type": "regex",
          "match": "/\\\\u[0-9A-Fa-f]{4}/",
          "label": "Unicode 解码",
          "minLength": 6
        }
      ]
    },
    {
      "code": "uuid",
      "explain": "UUID v4 生成(输入数字可批量)",
      "cmds": [
        "uuid",
        "guid",
        "唯一ID"
      ]
    },
    {
      "code": "timestamp",
      "explain": "时间戳与日期互转(输入框粘贴时间戳/日期可直接识别)",
      "cmds": [
        "timestamp",
        "时间戳",
        "ts",
        {
          "type": "regex",
          "match": "/^\\s*\\d{10}(\\d{3}(\\d{3}(\\d{3})?)?)?\\s*$/",
          "label": "时间戳转日期"
        },
        {
          "type": "regex",
          "match": "/^\\s*\\d{4}[-/.]\\d{1,2}[-/.]\\d{1,2}([ T]\\d{1,2}:\\d{2}(:\\d{2}(\\.\\d{1,3})?)?)?\\s*$/",
          "label": "日期转时间戳"
        }
      ]
    }
  ],
  "main": "index.html"
}