{
  "preload": "preload.js",
  "main": "index.html",
  "logo": "icons/logo.png",
  "platform": [
    "win32",
    "darwin"
  ],
  "categories": [
    "productivity"
  ],
  "author": "ScottLim",
  "features": [
    {
      "code": "search",
      "explain": "书签与历史记录全局搜索",
      "mainPush": true,
      "cmds": [
        "书签与历史记录搜索",
        {
          "type": "over",
          "maxLength": 40,
          "label": "书签与历史记录搜索"
        }
      ]
    },
    {
      "code": "settings",
      "explain": "为 Chrome / Edge 配置数据目录与程序路径",
      "cmds": [
        "书签与历史记录设置"
      ]
    }
  ],
  "tools": {
    "bookmarks_query": {
      "title": "书签搜索",
      "description": "在 Chrome、Edge 浏览器的书签中进行搜索",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "keyword": {
            "type": "string",
            "description": "搜索关键词"
          }
        },
        "required": [
          "keyword"
        ]
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "url"
          ]
        }
      }
    }
  },
  "name": "browser-bookmarks-history",
  "title": "书签与历史记录搜索",
  "description": "搜索 Chrome / Edge 浏览器书签与历史记录，支持便携版浏览器",
  "version": "2.5.0"
}