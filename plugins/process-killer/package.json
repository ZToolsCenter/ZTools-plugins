{
  "name": "ztools-process-killer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ZTools 插件：搜索进程名或端口，关闭/重启/查看进程",
  "scripts": {
    "build": "node scripts/build-process-killer.mjs",
    "package": "node scripts/build-process-killer.mjs --zip",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/ui-smoke.cjs && node test/ui-smoke-win.cjs && node test/auto-refresh.test.cjs"
  },
  "dependencies": {
    "vite": "^6.0.11",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "typescript": "^5.3.0",
    "vue-tsc": "^2.0.0"
  }
}
