{
  "name": "floating",
  "description": "将截图、图片文件置顶悬浮，同时支持缩放、旋转、翻转、增减透明度",
  "author": "qinyongliang",
  "homepage": "https://github.com/qinyongliang/",
  "preload": "preload.js",
  "version": "1.2.14",
  "logo": "icon.png",
  "features": [
    {
      "code": "suspend-screenshot",
      "cmds": [
        "截图并悬浮"
      ]
    },
    {
      "code": "suspend",
      "cmds": [
        { "type": "img", "label": "悬浮" },
        { "type": "files", "label": "悬浮", "fileType": "file", "extensions": ["png", "jpg", "jpeg", "gif", "bmp", "webp"], "minLength": 1, "maxLength": 1 }
      ]
    }
  ],
  "title": "悬浮"
}
