{
  "name": "rmb-capitalized",
  "title": "人民币大写",
  "description": "将阿拉伯数字转换为人民币大写金额，支持数字、千分位格式化互转。结果带「整」字。",
  "version": "1.0.1",
  "author": "SZYPXJ",
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "homepage": "https://github.com/ZToolsCenter/ZTools-plugins",
  "platform": ["win32", "darwin", "linux"],
  "keywords": ["人民币大写", "RMB", "大写", "金额", "数字转中文"],
  "features": [
    {
      "code": "rmb-open",
      "explain": "打开人民币大写转换器",
      "cmds": ["人民币大写", "RMB"]
    },
    {
      "code": "rmb-regex",
      "explain": "将阿拉伯数字转换为人民币大写金额",
      "cmds": [
        {
          "type": "regex",
          "label": "人民币大写",
          "match": "/^(\\d{1,16}|\\d{1,3}(?:,\\d{3}){1,4}|\\d(?:,\\d{3}){5})(?:\\.\\d{1,2})?$/",
          "minLength": 1
        }
      ]
    }
  ]
}
