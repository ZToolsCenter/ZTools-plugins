{
  "name": "ztools-json-formatter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local JSON formatter, validator and tree viewer for ZTools",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "verify": "node scripts/verify-package.mjs",
    "logo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-logo.ps1"
  },
  "dependencies": {
    "json5": "2.2.3"
  },
  "devDependencies": {
    "@electron/asar": "4.1.0",
    "adm-zip": "0.5.16",
    "vite": "7.1.6",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
