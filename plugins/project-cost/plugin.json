        "项目记账",
        "装修费用",
        "装修",
        "renovation",
        "project",
        "xm"
      ]
    },
    {
      "code": "project-add",
      "explain": "记一笔项目支出",
      "cmds": [
        "记项目支出",
        "项目支出",
        "新增支出",
        "记账",
        "记装修支出",
        "装修支出"
      ]
    },
    {
      "code": "project-pay",
      "explain": "项目付款跟踪与逾期提醒",
      "cmds": [
        "项目付款",
        "付款跟踪",
