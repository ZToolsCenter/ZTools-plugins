{
  "name": "batch-image-tools",
  "version": "1.1.0",
  "description": "批量压缩、格式转换、缩放图片",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "setup": "npm install --ignore-scripts && node scripts/setup-preload.mjs",
    "build": "node scripts/clean-build.mjs && tsc && vite build && node scripts/build-preload.mjs",
    "pack": "npm run build && node scripts/pack-plugin.mjs",
    "clean:legacy": "node scripts/remove-legacy-dirs.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "typescript": "^5.3.0",
    "vite": "^6.0.11"
  }
}
