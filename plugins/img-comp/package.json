{
  "name": "img-comp",
  "version": "1.0.2",
  "description": "ZTools 本地图片压缩插件，基于 JavaScript 与 WebAssembly 实现",
  "type": "module",
  "private": false,
  "main": "index.html",
  "author": "hanzhe",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
