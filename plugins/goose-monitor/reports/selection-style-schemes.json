            "label": "上下键移动",
            "lane": "用户",
            "step": 6
          },
          {
            "id": "expand",
            "label": "展开 helper 仍同组高亮",
            "lane": "样式层",
            "step": 7
          },
          {
            "id": "enter",
            "label": "回车打开关闭确认",
            "lane": "用户",
            "step": 8,
            "end": true
          }
        ],
        "transitions": [
          {
            "from": "open",
            "to": "default"
          },
          {
            "from": "default",
            "to": "paint"
          },
          {
            "from": "paint",
            "to": "search"
          },
          {
            "from": "search",
            "to": "reselect"
          },
          {
            "from": "reselect",
            "to": "move"
          },
          {
            "from": "move",
