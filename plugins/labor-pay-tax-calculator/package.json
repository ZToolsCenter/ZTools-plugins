{
  "name": "labor-pay-tax-calculator",
  "version": "1.0.1",
  "description": "按中国劳务报酬个税预扣标准，计算税后金额，并用税后金额反推税前金额。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
