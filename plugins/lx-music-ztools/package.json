{
  "name": "lx-music-ztools",
  "version": "0.1.2",
  "description": "LX Music native ZTools port with isolated custom sources, downloads and LX sync",
  "type": "module",
  "scripts": {
    "prebuild": "npm ci --prefix src-ztools/preload --omit=dev --no-audit --no-fund",
    "dev": "npm run build:runtime && node scripts/build-worker.mjs && webpack --watch --config build-config/ztools/webpack.config.cjs",
    "dev:diagnostics": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc && vite build && node scripts/build-runtime.mjs && node scripts/build-worker.mjs && node scripts/build-lx.mjs && node scripts/build-notices.mjs && node scripts/check.mjs",
    "build:ztools": "npm run build",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check:ztools": "vue-tsc && node scripts/check.mjs",
    "test:p0": "node scripts/test-p0.mjs",
    "test:source": "node scripts/test-source.mjs && node scripts/test-source-ui.mjs",
    "test:player": "node scripts/test-player.mjs",
    "test:ztools": "node --test tests/ztools/*.test.cjs",
    "test:ztools:e2e": "node scripts/test-e2e.mjs",
    "check": "node scripts/check.mjs",
    "pack": "npm run build && node scripts/package.mjs",
    "pack:ztools": "npm run pack",
    "publish:plugin": "node scripts/publish.mjs",
    "test:publish": "node scripts/rehearse-publish.mjs",
    "test:host": "node scripts/test-install.mjs"
  },
  "dependencies": {
    "@simonwep/pickr": "^1.9.1",
    "buffer": "^6.0.3",
    "comlink": "^4.3.1",
    "crypto-browserify": "^3.12.1",
    "crypto-js": "^4.2.0",
    "events": "^3.3.0",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.1.4",
    "long": "^5.3.2",
    "pako": "^3.0.3",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "sortablejs": "^1.15.7",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.58.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/plugin-cli": "1.3.2",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "css-loader": "^7.1.5",
    "esbuild": "^0.25.12",
    "html-webpack-plugin": "^5.6.7",
    "less": "^4.9.1",
    "less-loader": "12.3.3",
    "postcss": "8.5.32",
    "postcss-loader": "8.2.1",
    "postcss-pxtorem": "6.1.0",
    "pug": "^3.0.4",
    "pug-plain-loader": "^1.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.3.0",
    "vite": "^6.0.11",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^2.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  }
}
