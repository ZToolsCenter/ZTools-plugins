{
  "name": "startup-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "跨平台查看并安全管理用户级开机启动项。",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.cjs tests/*.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "build:dist": "npm run typecheck && npm test && vite build && node ../../scripts/finalize-module-dist.mjs startup-manager",
    "build": "npm run build:dist",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.11",
    "vue-tsc": "^3.3.8"
  }
}
