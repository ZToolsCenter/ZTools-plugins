{
  "name": "windows-awake",
  "version": "1.0.0",
  "description": "保持 Windows 唤醒，可设置唤醒时长并选择是否允许息屏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:logo": "node scripts/build-logo.mjs",
    "package:zpx": "npm run build && node scripts/build-zpx.mjs",
    "preview": "vite preview",
    "test:guard": "node tests/guard/guard.cjs",
    "test:e2e": "npm run build && playwright test --config=playwright.e2e.config.js"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@ztools-center/ztools-api-types": "^1.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.3.0",
    "vite": "^6.0.11",
    "vue-tsc": "^2.0.0"
  }
}
